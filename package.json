{
  "name": "vcrkit",
  "version": "1.0.2",
  "description": "Zero-ceremony VCR (record/replay) HTTP tests on top of nock, with first-class secret loading and redaction.",
  "keywords": [
    "cassette",
    "http",
    "nock",
    "record",
    "replay",
    "test",
    "vcr",
    "vitest"
  ],
  "license": "MIT",
  "author": "Sophia Willows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sophiabits/vcrkit.git"
  },
  "bin": {
    "vcrkit": "dist/bin/vcrkit.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./secrets": {
      "types": "./dist/secrets.d.ts",
      "import": "./dist/secrets.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.ts",
    "vcrkit": "node --experimental-strip-types --no-warnings src/bin/vcrkit.ts",
    "test:vcr": "cd examples/httpbin && node --experimental-strip-types --no-warnings ../../src/bin/vcrkit.ts replay",
    "lint": "oxlint",
    "fix": "oxlint --fix && oxfmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test && pnpm test:e2e",
    "test:acceptance": "pnpm build && pnpm install && pnpm -r --filter '@vcrkit-acceptance/*' test"
  },
  "dependencies": {
    "nock": "^14.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1057.0",
    "@aws-sdk/client-ssm": "^3.1057.0",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "*",
    "@aws-sdk/client-ssm": "*",
    "@google-cloud/secret-manager": "*",
    "vitest": ">=2 <5"
  },
  "peerDependenciesMeta": {
    "@google-cloud/secret-manager": {
      "optional": true
    },
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@aws-sdk/client-ssm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "22.13.1"
  },
  "packageManager": "pnpm@11.5.0"
}
